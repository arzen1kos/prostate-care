---
// <!-- Imported by: components/layout/Footer.astro -->
interface Props {
  title: string;
  description: string;
  placeholder: string;
  buttonText: string;
}

const { title, description, placeholder, buttonText } = Astro.props;
---

<div class="flex flex-col md:max-lg:w-1/2 lg:max-w-sm">
  <p class="font-semibold text-base md:text-lg text-neutral dark:text-gray-300">{title}</p>
  <p class="mb-5 pt-2 text-neutral/80 text-sm dark:text-gray-300">
    {description}
  </p>
  <form
    action="#"
    method="post"
    class="flex flex-col sm:flex-row gap-3 ">
    <input 
      class="h-10 rounded-lg border border-primary dark:text-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-[1px] focus:ring-primary flex-grow placeholder:text-neutral/60" 
      type="email"
      placeholder={placeholder}
      name="email"
      id="email"
      required>
    <button
      type="submit"
      class="h-10 px-5 border bborder-primary dark:text-gray-300 text-sm font-medium hover:cursor-pointer rounded-lg">
      {buttonText}
    </button>
  </form>
</div>
