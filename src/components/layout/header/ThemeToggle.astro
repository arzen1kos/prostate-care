---
// <!-- Referenced by: components/common/navigation/NavItem.astro -->
import Icon from '../../ui/Icon.astro';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg transition-colors text-sm p-2"
>
<!-- Sun icon for dark mode -->
  <svg 
    id="theme-toggle-light-icon" 
    class="w-5 h-5 hidden" 
    fill="var(--color-sun)"
    stroke="var(--color-sun)"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    viewBox="0 0 24 24" 
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  
  <!-- Moon icon for light mode -->
  <svg 
    id="theme-toggle-dark-icon" 
    class="w-5 h-5" 
    fill="var(--color-moon)"
    stroke="var(--color-moon)"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    viewBox="0 0 24 24" 
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <!-- <Icon id="icon-moon" name="sun-moon" class="w-5 h-5 block" color="var(--color-palette-four" /> -->
</button>