---
const { name, description, thumbnail, address, phone, link } = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-lg border border-neutral-200 drop-shadow-3xl bg-slate-800/20  hover:bg-slate-600/20">
    <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 text-sm font-medium no-underline hover:no-underline"
    >
        <div class="aspect-4/3 sm:aspect-6/3 w-full overflow-hidden">
        <img
            src={thumbnail}
            alt={`Map of ${name}`}
            class="h-full w-full object-cover px-3 rounded-s"
            loading="lazy"
        />
        </div>

        <div class="flex flex-1 flex-col p-4">
            <h3 class="text-base font-semibold text-blue-950">{name}</h3>
            <p class="mt-1 text-sm text-neutral-800 line-clamp-2">{description}</p>

            <address class="mt-3 text-sm not-italic text-neutral-700">
                {address.join(", ")}
            </address>

            {phone && (
            <div class="flex gap-4 align-middle mt-4 text-sm text-neutral-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32"><g fill="none" stroke="#212121" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.00"><path d="M3 12c0-7 7-7 13-7s13 0 13 7c0 8-7-1-7-1H10s-7 9-7 1m8 2s-5 5-5 14h20c0-9-5-14-5-14z"/><circle cx="16" cy="21" r="4"/></g></svg>
                {phone}
            </div>
            )}
        </div>
    </a>
</article>