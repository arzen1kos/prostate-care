---
import { staticMapUrl } from "@utils/static-map-url";

const { name, lat, lng, radiusKm = 1, address, phone, link } = Astro.props;
const mapUrl = staticMapUrl(lat, lng, radiusKm);
---

<article class="flex flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white">
    <div class="aspect-[4/3] w-full overflow-hidden">
    <img
        src={mapUrl}
        alt={`Map of ${name}`}
        class="h-full w-full object-cover"
        loading="lazy"
    />
    </div>

    <div class="flex flex-1 flex-col p-4">
    <h3 class="text-base font-semibold text-neutral-900">{name}</h3>
    <p class="mt-1 text-sm text-neutral-600 line-clamp-2">{description}</p>

    <address class="mt-3 text-sm not-italic text-neutral-500">
        {address.join(", ")}
    </address>

    {phone && (
        <p class="mt-2 text-sm text-neutral-500">
        <a href={`tel:${phone.replace(/\s+/g, "")}`} class="hover:underline">
            {phone}
        </a>
        </p>
    )}

    <div class="flex-1" />

    <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 text-sm font-medium text-blue-600 hover:underline"
    >
        Directions
        <span class="sr-only"> for {name} (opens in a new tab)</span>
    </a>
    </div>
</article>