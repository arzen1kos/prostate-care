---
const {
  id,
  variant = 'primary',
  size,
  href,
  type,
  class: className = '',
  disabled = false,
  fullWidth = false,
  dataLabel,
  ariaLabel,
} = Astro.props;

// Base classes
const baseClasses = 'inline-flex items-center justify-center rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none';

// Size classes
const sizeClasses = {
  sm: 'h-8 px-3 text-xs',
  md: 'h-10 px-4 py-2',
  lg: 'h-20 px-5 py-3 text-lg'
};

// Variant classes
const variantClasses = {
  primary: 'bg-[var(--color-palette-four)] text-[var(--color-palette-one)] hover:bg-[var(--color-palette-three)] hover:text-[var(--color-palette-five)] focus-visible:ring-[var(--color-primary-focus-ring)] no-underline',
  hero: 'bg-[var(--color-palette-accent)] text-[var(--color-palette-one)] hover:bg-[var(--color-palette-three)] hover:text-[var(--color-palette-five)] focus-visible:ring-[var(--color-primary-focus-ring)] no-underline',
  secondary: 'px-10 py-3 bg-gray-500 text-gray-900 hover:bg-gray-300 focus-visible:ring-gray-500 no-underline',
  outline: 'border border-gray-300 bg-transparent hover:bg-gray-100 focus-visible:ring-gray-500',
  ghost: 'bg-transparent hover:bg-gray-100 focus-visible:ring-gray-500',
  link: 'bg-[var(--color-palette-three)] text-[var(--color-palette-five)] hover:bg-[var(--color-palette-five)] hover:text-[var(--color-palette-one)] focus-visible:ring-blue-500 p-0 h-auto no-underline',
  // hero:'bg-[var(--color-palette-accent)] hover:bg-[var(--color-palette-three)] no-underline text-lg md:text-xl'
};

const classes = [
  baseClasses,
  sizeClasses[size],
  variantClasses[variant],
  fullWidth ? 'w-full' : '',
  className
].join(' ');

const Element = href ? 'a' : 'button';
---

<Element
  href={href}
  type={!href ? type : null}
  class={classes}
  disabled={disabled}
  aria-label={ariaLabel}
>
  <slot />
</Element>
