---
import Icon from './Icon.astro';
import Button from './Button.astro';
---

<div class="flex flex-col items-center text-sm mb-7">
<hr>
  <details class="w-max">
    <summary class="list-none cursor-pointer flex items-center justify-center gap-1 text-[var(--color-palette-four)] no-underline select-none">
      <Icon class="icon" name="info" size={16} color="var(--color-palette-four)"/>
      READ me
    </summary>
    <p class="mt-2 italic text-[var(--color-palette-four)] text-center">
      <strong>Note:</strong> Some low-contrast cards are still in progress.<br />
      We’re quietly working on them — thank you for your patience 🛠️.
    </p>
  </details>
</div>

<style>
  details[open] summary > .icon {
    transform: rotate(45deg);
    transition: transform 0.2s ease-in-out;
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
