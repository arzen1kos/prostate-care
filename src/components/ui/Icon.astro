---
import { icons } from '../../lib/types/IconLibrary';

interface Props {
  id?: string;
  name: string;
  color?: string;
  size?: number;
  class?: string;
  stroke?: number;
  fill?: string;
  strokeLinejoin?: 'round' | 'bevel' | 'miter';
  viewBox?: string;
}

const {
  name,
  color = 'currentColor',
  size = 24,
  class: className = '',
  stroke = 1.5,
  fill = 'none',
  strokeLinejoin = 'round',
  viewBox = '0 0 24 24',
} = Astro.props;

// Get the SVG path(s) from the icon library
const icon = icons[name] || icons['placeholder'];
const isTheme = name === 'sun-moon';
---

{!isTheme ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox={viewBox}
    fill={fill}
    stroke={color}
    stroke-width={stroke}
    stroke-linejoin={strokeLinejoin}
    class={className}
    aria-hidden="true"
  >
    <g>
      {Array.isArray(icon) ? (
        icon.map((d, i) => <path d={d}/>)
      ) : (
        <path d={icon} />
      )}
    </g>
  </svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    <path
      d="M16 12a4 4 0 1 1-5-3.87 3 3 0 1 0 5 3.87z"
      fill="var(--color-orange-200)"
      stroke="var(--color-brown-200)"
    />
  </svg>
)}
