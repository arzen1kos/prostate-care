---
import Icon from '../../components/ui/Icon.astro';
const {
    head,
    content
} = Astro.props;

const textColor = "text-[var(--color-palette-two)]";
// const textHoverColor = "hover:text-[var(--color-palette-two)]";
// const bgColor = "hover:text-[var(--color-palette-gray)]";
const bgColor = "bg-[var(--color-palette-light-gray)]";
---
<div class=`${bgColor} flex items-start gap-7 my-5 border-l-4 py-6 border-blue-500 p-4 rounded shadow transition-colors duration-300`>
    <div class=`text-1xl item-center justify-center mr-2`>💡</div>
    <div class=``>
        <p class=`${textColor} font-bold scale-105 mb-2`>{head}</p>
        <p class=`${textColor}` set:html={content}></p>
    </div>
</div>