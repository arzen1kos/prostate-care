---
const { } = Astro.props;
---
<div class="w-full px-3 py-2" id="detail-panel">
  <div class="pb-4 mb-4 border-b border-neutral-100">
    <h2 class="text-2xl font-bold text-secondary mb-1" id="detail-title">Select a node</h2>
    <p class="text-neutral-500 text-sm" id="detail-subtitle">Click on any node to view details</p>
  </div>
  <div id="detail-content" class="space-y-6">
    <!-- Content will be dynamically inserted here -->
    <div class="text-center text-neutral-400 py-12">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
      </svg>
      <p>Select a node from the diagram to view detailed information</p>
    </div>
  </div>
</div>
