---
// CanvasNav.astro
// An Obsidian-style pan/zoom canvas for site navigation.
//
// - Left-click a node -> show its articles and reveal its immediate children.
// - Right-click a node -> expand/collapse its children (if it has any).
// - Below the tablet breakpoint (max-width: 767px) the canvas is disabled
//   entirely and a simple stacked link list is shown instead.
//
// `edges` are DIRECTED as [parentId, childId] — this is what drives both
// the connecting lines AND the collapse/expand hierarchy. Each child should
// have exactly one parent for collapse/expand to behave predictably; if a
// node has multiple parents, only the first-seen parent is used for that.
//
// Usage on any page:
//
//   ---
//   import CanvasNav from '../components/CanvasNav.astro';
//   const nodes = [
//     { id: 'home', title: 'Home', excerpt: 'Landing page', url: '/', x: 1000, y: 120, type: 'core' },
//     { id: 'about', title: 'About', excerpt: 'Who this is for', url: '/about', x: 660, y: 320, type: 'core' },
//   ];
//   const edges: [string, string][] = [ ['home', 'about'] ];
//   ---
//   <CanvasNav nodes={nodes} edges={edges} currentPath={Astro.url.pathname} />

interface CanvasNode {
  id: string;
  title: string;
  excerpt: string;
  url: string;
  x: number;
  y: number;
  type: 'core' | 'content' | 'utility' | 'question' | 'option' | 'article';
}

interface Props {
  nodes: CanvasNode[];
  edges: [string, string][];
  currentPath?: string;
  height?: string; // CSS height, defaults to 100vh
}

const { nodes, edges, currentPath = '', height = '80vh' } = Astro.props;

// Mark whichever node matches the current route.
const nodesWithHere = nodes.map((n) => ({
  ...n,
  here: currentPath === n.url,
}));

// Flat list for the mobile fallback, grouped by type for a bit of structure.
const mobileGroups: Record<string, typeof nodesWithHere> = { core: [], content: [], utility: [] };
nodesWithHere.forEach((n) => mobileGroups[n.type]?.push(n));
---

<div class="canvas-nav-root" style={`height: ${height};`}>
  <!-- Desktop / tablet: interactive canvas -->
  <div class="desktop-canvas">
    <div id="canvas-wrap">
      <div id="canvas-inner">
        <svg id="edges"></svg>
        {
          nodesWithHere.map((n) => (
            <div
              class={`node ${n.type}${n.here ? ' here' : ''}`}
              id={`node-${n.id}`}
              data-id={n.id}
              data-url={n.url}
              role="button"
              tabindex="0"
              aria-expanded="false"
              style={`left:${n.x}px; top:${n.y}px;`}
            >
              <div class="eyebrow">{n.type}</div>
              <h3>{n.title}</h3>
              <p>{n.excerpt}</p>
              <span class="child-badge" style="display:none;"></span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="left__panel">
      <div id="legend">
        <table class="hint">
          <tr>
            <th class="legend__left"></th>
            <th class="legend__right"></th>
          </tr>
          <tr>
            <td class="legend__left">
              <svg xmlns="http://www.w3.org/2000/svg" 
                width="24" 
                height="24" 
                viewBox="0 0 24 24">
                <path 
                  d="M12 16.5a.75.75 0 0 1 .744.648l.007.102v2.188l.72-.718a.75.75 0 0 1 .976-.073l.084.073a.75.75 0 0 1 .072.976l-.072.084l-2 2l-.038.036l-.072.055l-.095.055l-.087.035l-.102.026l-.085.011h-.103l-.12-.018l-.068-.02l-.059-.022l-.07-.035l-.052-.032l-.031-.022a1 1 0 0 1-.079-.069l-2-2a.75.75 0 0 1 .977-1.133l.084.073l.72.719v-2.19a.75.75 0 0 1 .648-.742zM12 9a3 3 0 1 1 0 6a3 3 0 0 1 0-6m6.72.47a.75.75 0 0 1 .977-.073l.084.072l2 2l.036.039l.055.072l.055.095l.035.086l.026.103l.01.084v.103l-.017.12l-.02.068l-.022.059l-.035.07l-.032.052l-.028.038l-.063.072l-2 2a.75.75 0 0 1-1.133-.976l.072-.085l.719-.72H17.25a.75.75 0 0 1-.744-.647L16.501 12a.75.75 0 0 1 .648-.743l.102-.007h2.189l-.72-.72a.75.75 0 0 1-.072-.976zm-14.5 0a.75.75 0 0 1 1.134.976l-.073.084l-.72.72h2.19a.75.75 0 0 1 .743.648L7.5 12a.75.75 0 0 1-.649.743l-.101.007H4.56l.72.72a.75.75 0 0 1 .073.976l-.073.084a.75.75 0 0 1-.977.073l-.084-.073l-2-2l-.09-.11l-.055-.095l-.036-.086l-.026-.103l-.011-.09v-.093l.018-.125l.02-.067l.022-.06l.035-.07l.032-.052l.023-.03a1 1 0 0 1 .068-.08zM12 10.5a1.5 1.5 0 1 0 0 3a1.5 1.5 0 0 0 0-3m-.136-8.488l.067-.009l.087-.003l.06.004l.094.016l.068.019l.059.022l.07.036l.052.032l.038.027l.072.063l2 2a.75.75 0 0 1-.977 1.134l-.084-.073l-.72-.72v2.19a.75.75 0 0 1-.648.743l-.101.007a.75.75 0 0 1-.744-.648l-.006-.102V4.56l-.72.72a.75.75 0 0 1-.977.073L9.47 5.28a.75.75 0 0 1-.072-.976l.072-.085l2-2l.11-.09l.095-.055l.087-.035z"
                />
              </svg>
            </td>
            <td class="legend__right">drag background to pan</td>
          </tr>
          <tr>
            <td class="legend__left">
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                width="24" 
                height="24" 
                viewBox="0 0 256 256"
              >
              <path 
                fill="#212121"
                stroke="#212121" 
                stroke-width="1.5px"
                d="M144 16h-32a64.07 64.07 0 0 0-64 64v96a64.07 64.07 0 0 0 64 64h32a64.07 64.07 0 0 0 64-64V80a64.07 64.07 0 0 0-64-64m48 160a48.05 48.05 0 0 1-48 48h-32a48.05 48.05 0 0 1-48-48V80a48.05 48.05 0 0 1 48-48h32a48.05 48.05 0 0 1 48 48Zm-56-92.69v89.38l10.34-10.35a8 8 0 0 1 11.32 11.32l-24 24a8 8 0 0 1-11.32 0l-24-24a8 8 0 0 1 11.32-11.32L120 172.69V83.31l-10.34 10.35a8 8 0 0 1-11.32-11.32l24-24a8 8 0 0 1 11.32 0l24 24a8 8 0 0 1-11.32 11.32Z"
              />
            </svg>
            </td>
            <td class="legend__right">scroll to zoom</td>
          </tr>
          <tr>
            <td class="legend__left">
              <svg xmlns="http://www.w3.org/2000/svg" 
                width="24" 
                height="24" 
                viewBox="0 0 14 14">
                <g 
                  fill="none" 
                  stroke="#212121" 
                  stroke-width="1px"
                  stroke-linecap="round" 
                  stroke-linejoin="round">
                  <path 
                    d="M2.023 5.317C2.023 2.915 4.18.706 6.634.706m-2.065 9.71c.103 1.436 1.215 2.677 2.647 2.823c.333.034.67.055 1.01.055s.677-.021 1.01-.055c1.432-.146 2.544-1.387 2.647-2.823c.054-.736.094-1.487.094-2.251s-.04-1.516-.094-2.252c-.103-1.435-1.215-2.676-2.647-2.822a10 10 0 0 0-1.01-.056c-.34 0-.677.022-1.01.056c-1.432.146-2.544 1.387-2.647 2.822a31 31 0 0 0-.094 2.252c0 .764.04 1.515.094 2.251"/><path d="M8.225 3.035v3.56a1 1 0 0 1-1.002 1a344 344 0 0 0-2.748.003"
                  />
                </g>
              </svg>
            </td>
            <td class="legend__right">left-click for articles and next step</td>
          </tr>
          <tr>
            <td class="legend__left">
              <svg xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 14 14">
              <g
                transform="translate(15,0) scale(-1,1)"
                fill="none"
                stroke="#212121"
                stroke-width="1px"
                stroke-linecap="round"
                stroke-linejoin="round">
                
                <path d="M2.023 5.317C2.023 2.915 4.18.706 6.634.706m-2.065 9.71c.103 1.436 1.215 2.677 2.647 2.823c.333.034.67.055 1.01.055s.677-.021 1.01-.055c1.432-.146 2.544-1.387 2.647-2.823c.054-.736.094-1.487.094-2.251s-.04-1.516-.094-2.252c-.103-1.435-1.215-2.676-2.647-2.822a10 10 0 0 0-1.01-.056c-.34 0-.677.022-1.01.056c-1.432.146-2.544 1.387-2.647 2.822a31 31 0 0 0-.094 2.252c0 .764.04 1.515.094 2.251"/>
                
                <path d="M8.225 3.035v3.56a1 1 0 0 1-1.002 1a344 344 0 0 0-2.748.003"/>
              
              </g>
            </svg>
            </td>
            <td class="legend__right">right-click to expand/collapse</td>
          </tr>
        </table>
      </div>
      <div id="controls">
        <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
        <span id="zoom-label">100%</span>
        <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
        <button id="zoom-reset" type="button" aria-label="Reset view">⟲</button>
      </div>
    </div>
          <div class="article-panel" aria-label="Related articles" aria-hidden="true">
        <div class="article-panel__header">
          <div>
            <p class="article-panel__eyebrow">Explore this topic</p>
            <h2 class="article-panel__title"></h2>
          </div>
          <button class="article-panel__close" type="button" aria-label="Close articles panel">×</button>
        </div>
        <p class="article-panel__count"></p>
        <div class="article-panel__list"></div>
      </div>
  </div>

  <!-- Mobile: plain link list, canvas is disabled entirely -->
  <nav class="mobile-fallback" aria-label="Site pages">
    {
      Object.entries(mobileGroups).map(([type, group]) =>
        group.length > 0 && (
          <div class="mobile-group">
            <div class="mobile-group-label">{type}</div>
            {group.map((n) => (
              <a class={`mobile-link${n.here ? ' here' : ''}`} href={n.url}>
                <span class="mobile-link-title">{n.title}</span>
                <span class="mobile-link-excerpt">{n.excerpt}</span>
              </a>
            ))}
          </div>
        )
      )
    }
  </nav>
</div>

<script define:vars={{ nodes: nodesWithHere, edges }}>
  const root = document.currentScript.previousElementSibling.classList.contains('canvas-nav-root')
    ? document.currentScript.previousElementSibling
    : document.querySelector('.canvas-nav-root');

  const wrap = root.querySelector('#canvas-wrap');
  const inner = root.querySelector('#canvas-inner');
  const svg = root.querySelector('#edges');
  const zoomLabel = root.querySelector('#zoom-label');
  const articlePanel = root.querySelector('.article-panel');
  const articlePanelTitle = root.querySelector('.article-panel__title');
  const articlePanelCount = root.querySelector('.article-panel__count');
  const articlePanelList = root.querySelector('.article-panel__list');
  const nodeById = new Map(nodes.map((node) => [node.id, node]));

  // live positions, since nodes can be dragged
  const state = nodes.map((n) => ({ ...n }));

  // --- hierarchy for collapse/expand, derived from directed edges [parent, child] ---
  const childrenOf = {};   // parentId -> [childId, ...]
  const parentOf = {};     // childId -> parentId (first-seen wins)
  edges.forEach(([a, b]) => {
    (childrenOf[a] = childrenOf[a] || []).push(b);
    if (!(b in parentOf)) parentOf[b] = a;
  });
  const collapsed = new Set(); // ids currently collapsed
  const rootNode = state.find((node) => node.id === 'start' || !(node.id in parentOf)) || state[0];
  let activeNodeId = rootNode?.id;
  let contextExpandedId = null;

  function descendantsOf(id) {
    const descendants = [];
    const visit = (parentId) => {
      (childrenOf[parentId] || []).forEach((childId) => {
        descendants.push(childId);
        visit(childId);
      });
    };
    visit(id);
    return descendants;
  }

  function showArticlesFor(id) {
    const selectedNode = nodeById.get(id);
    const articles = [selectedNode, ...descendantsOf(id).map((nodeId) => nodeById.get(nodeId))]
      .filter((node) => node && node.type === 'article' && node.url);

    articlePanelTitle.textContent = selectedNode.title;
    articlePanelCount.textContent = `${articles.length} article${articles.length === 1 ? '' : 's'}`;
    articlePanelList.replaceChildren();

    if (articles.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'article-panel__empty';
      empty.textContent = 'No articles are available for this topic yet.';
      articlePanelList.appendChild(empty);
    } else {
      articles.forEach((article) => {
        const card = document.createElement('a');
        card.className = 'article-card';
        card.href = article.url;

        const title = document.createElement('span');
        title.className = 'article-card__title';
        title.textContent = article.title;
        card.appendChild(title);

        const excerpt = document.createElement('span');
        excerpt.className = 'article-card__excerpt';
        excerpt.textContent = article.excerpt;
        card.appendChild(excerpt);
        articlePanelList.appendChild(card);
      });
    }

    articlePanel.classList.add('is-open');
    articlePanel.setAttribute('aria-hidden', 'false');
  }

  function closeArticlePanel() {
    articlePanel.classList.remove('is-open');
    articlePanel.setAttribute('aria-hidden', 'true');
  }

  function resetBranch(id) {
    collapsed.delete(id);
    descendantsOf(id).forEach((descendantId) => collapsed.delete(descendantId));
  }

  function openPathTo(id) {
    let childId = id;
    let parentId = parentOf[childId];
    while (parentId) {
      collapsed.delete(parentId);
      (childrenOf[parentId] || []).forEach((siblingId) => {
        if (siblingId !== childId) collapsed.add(siblingId);
      });
      childId = parentId;
      parentId = parentOf[childId];
    }
  }

  function openOneLevel(id) {
    openPathTo(id);
    resetBranch(id);
    (childrenOf[id] || []).forEach((childId) => {
      if ((childrenOf[childId] || []).length > 0) collapsed.add(childId);
    });
  }

  function isAncestorOf(ancestorId, nodeId) {
    let parentId = parentOf[nodeId];
    while (parentId) {
      if (parentId === ancestorId) return true;
      parentId = parentOf[parentId];
    }
    return false;
  }

  function updateAriaExpanded() {
    state.forEach((node) => {
      const el = root.querySelector(`#node-${node.id}`);
      if (!el) return;
      const hasChildren = (childrenOf[node.id] || []).length > 0;
      const isExpanded = hasChildren && (
        node.id === contextExpandedId ||
        isAncestorOf(node.id, activeNodeId) ||
        node.id === activeNodeId && node.id === rootNode?.id
      );
      el.setAttribute('aria-expanded', String(isExpanded));
    });
  }

  function isVisible(id) {
    let cur = parentOf[id];
    while (cur) {
      if (collapsed.has(cur)) return false;
      cur = parentOf[cur];
    }
    return true;
  }

  function updateBadges() {
    state.forEach((n) => {
      const el = root.querySelector(`#node-${n.id}`);
      if (!el) return;
      const kids = childrenOf[n.id];
      const badge = el.querySelector('.child-badge');
      if (kids && kids.length > 0) {
        badge.style.display = 'inline-flex';
        badge.textContent = (collapsed.has(n.id) ? '▸ ' : '▾ ') + kids.length;
      } else {
        badge.style.display = 'none';
      }
    });
  }

  function updateVisibility() {
    state.forEach((n) => {
      const el = root.querySelector(`#node-${n.id}`);
      if (!el) return;
      el.style.display = isVisible(n.id) ? '' : 'none';
    });
    updateBadges();
    updateAriaExpanded();
    renderEdges();
  }

  let scale = 1, tx = 0, ty = 0;
  let panning = false, panStart = { x: 0, y: 0 }, startTx = 0, startTy = 0;
  let draggingNode = null, dragOffset = {};

  function applyTransform() {
    inner.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    zoomLabel.textContent = Math.round(scale * 100) + '%';
  }

  function nodeCenter(n) {
    const el = root.querySelector(`#node-${n.id}`);
    const w = el ? el.offsetWidth : 210;
    const h = el ? el.offsetHeight : 70;
    return { x: n.x + w / 2, y: n.y + h / 2 };
  }

  function renderEdges() {
    svg.innerHTML = '';
    edges.forEach(([a, b]) => {
      if (!isVisible(a) || !isVisible(b)) return;
      const na = state.find((n) => n.id === a);
      const nb = state.find((n) => n.id === b);
      if (!na || !nb) return;
      const pa = nodeCenter(na), pb = nodeCenter(nb);
      const midX = (pa.x + pb.x) / 2;
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('class', 'edge');
      path.setAttribute('data-a', a);
      path.setAttribute('data-b', b);
      path.setAttribute('d', `M ${pa.x} ${pa.y} C ${midX} ${pa.y}, ${midX} ${pb.y}, ${pb.x} ${pb.y}`);
      svg.appendChild(path);
    });
  }

  function litEdgesFor(id) {
    root.querySelectorAll('.edge').forEach((p) => {
      p.classList.toggle('lit', p.dataset.a === id || p.dataset.b === id);
    });
  }

  // --- interactivity is only wired up when the canvas is actually visible (tablet/desktop) ---
  const mq = window.matchMedia('(min-width: 768px)');
  let canvasActive = false;

  function attachInteractivity() {
    if (canvasActive) return;
    canvasActive = true;

    inner.addEventListener('pointerover', onPointerOver);
    inner.addEventListener('pointerout', onPointerOut);
    wrap.addEventListener('pointerdown', onWrapPointerDown);
    wrap.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('pointermove', onWindowPointerMove);
    window.addEventListener('pointerup', onWindowPointerUp);

    state.forEach((n) => {
      const el = root.querySelector(`#node-${n.id}`);
      if (!el) return;
      el.addEventListener('pointerdown', onNodePointerDown(n, el));
      el.addEventListener('click', onNodeClick(n, el));
      el.addEventListener('keydown', onNodeKeyDown(n, el));
      el.addEventListener('contextmenu', onNodeContextMenu(n));
    });

    // center on the "here" node, or the first node
    const focus = state.find((n) => n.here) || state[0];
    if (focus) {
      const r = wrap.getBoundingClientRect();
      const c = nodeCenter(focus);
      tx = r.width / 2 - c.x;
      ty = r.height / 2 - c.y;
    }
    applyTransform();
    updateVisibility();

    root.querySelector('#zoom-in').addEventListener('click', zoomInHandler);
    root.querySelector('#zoom-out').addEventListener('click', zoomOutHandler);
    root.querySelector('#zoom-reset').addEventListener('click', zoomResetHandler);
    articlePanel.querySelector('.article-panel__close').addEventListener('click', closeArticlePanel);
    articlePanel.addEventListener('pointerdown', onPanelPointerDown);
    window.addEventListener('keydown', onWindowKeyDown);
  }

  function detachInteractivity() {
    if (!canvasActive) return;
    canvasActive = false;

    inner.removeEventListener('pointerover', onPointerOver);
    inner.removeEventListener('pointerout', onPointerOut);
    wrap.removeEventListener('pointerdown', onWrapPointerDown);
    wrap.removeEventListener('wheel', onWheel);
    window.removeEventListener('pointermove', onWindowPointerMove);
    window.removeEventListener('pointerup', onWindowPointerUp);
    window.removeEventListener('keydown', onWindowKeyDown);

    state.forEach((n) => {
      const el = root.querySelector(`#node-${n.id}`);
      if (!el) return;
      const clone = el.cloneNode(true); // cheap way to strip all listeners
      el.parentNode.replaceChild(clone, el);
    });

    root.querySelector('#zoom-in')?.removeEventListener('click', zoomInHandler);
    root.querySelector('#zoom-out')?.removeEventListener('click', zoomOutHandler);
    root.querySelector('#zoom-reset')?.removeEventListener('click', zoomResetHandler);
    articlePanel.querySelector('.article-panel__close')?.removeEventListener('click', closeArticlePanel);
    articlePanel.removeEventListener('pointerdown', onPanelPointerDown);
  }

  function onPointerOver(e) {
    const node = e.target.closest('.node');
    if (node) litEdgesFor(node.dataset.id);
  }
  function onPointerOut(e) {
    const node = e.target.closest('.node');
    if (node) root.querySelectorAll('.edge').forEach((p) => p.classList.remove('lit'));
  }
  function onWrapPointerDown(e) {
    if (e.button !== 0) return; // left button only — right-click is reserved for context menu
    if (e.target.closest('.node')) return;
    panning = true;
    wrap.classList.add('grabbing');
    panStart = { x: e.clientX, y: e.clientY };
    startTx = tx; startTy = ty;
  }
  function onWindowPointerMove(e) {
    if (panning) {
      tx = startTx + (e.clientX - panStart.x);
      ty = startTy + (e.clientY - panStart.y);
      applyTransform();
    } else if (draggingNode) {
      const dx = (e.clientX - dragOffset.startX) / scale;
      const dy = (e.clientY - dragOffset.startY) / scale;
      draggingNode.n.x = dragOffset.origX + dx;
      draggingNode.n.y = dragOffset.origY + dy;
      draggingNode.el.style.left = draggingNode.n.x + 'px';
      draggingNode.el.style.top = draggingNode.n.y + 'px';
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) draggingNode.el.dataset.dragged = '1';
      renderEdges();
    }
  }
  function onWindowPointerUp() {
    panning = false;
    wrap.classList.remove('grabbing');
    if (draggingNode) draggingNode.el.classList.remove('dragging');
    draggingNode = null;
  }
  function onNodePointerDown(n, el) {
    return (e) => {
      if (e.button !== 0) return; // left button only
      e.stopPropagation();
      draggingNode = { n, el };
      dragOffset = { startX: e.clientX, startY: e.clientY, origX: n.x, origY: n.y };
      el.classList.add('dragging');
      el.dataset.dragged = '0';
    };
  }
  function onPanelPointerDown(e) {
    e.stopPropagation();
  }
  function selectNode(n, el) {
    if (el.dataset.dragged === '1') { el.dataset.dragged = '0'; return; }
    activeNodeId = n.id;
    contextExpandedId = null;
    showArticlesFor(n.id);
    openOneLevel(n.id);
    updateVisibility();
  }
  function onNodeClick(n, el) {
    return () => selectNode(n, el);
  }
  function onNodeKeyDown(n, el) {
    return (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      selectNode(n, el);
    };
  }
  function onWindowKeyDown(e) {
    if (e.key === 'Escape' && articlePanel.classList.contains('is-open')) closeArticlePanel();
  }
  function onNodeContextMenu(n) {
    return (e) => {
      e.preventDefault();
      const kids = childrenOf[n.id];
      if (!kids || kids.length === 0) return;
      activeNodeId = n.id;
      openPathTo(n.id);
      if (collapsed.has(n.id)) {
        collapsed.delete(n.id);
        contextExpandedId = n.id;
      } else {
        collapsed.add(n.id);
        contextExpandedId = null;
      }
      updateVisibility();
    };
  }

  function setZoom(newScale, cx, cy) {
    newScale = Math.min(2, Math.max(0.4, newScale));
    const rect = wrap.getBoundingClientRect();
    const px = (cx - rect.left - tx) / scale;
    const py = (cy - rect.top - ty) / scale;
    tx = cx - rect.left - px * newScale;
    ty = cy - rect.top - py * newScale;
    scale = newScale;
    applyTransform();
  }
  function onWheel(e) {
    e.preventDefault();
    setZoom(scale - e.deltaY * 0.001, e.clientX, e.clientY);
  }
  function zoomInHandler() {
    const r = wrap.getBoundingClientRect();
    setZoom(scale + 0.15, r.left + r.width / 2, r.top + r.height / 2);
  }
  function zoomOutHandler() {
    const r = wrap.getBoundingClientRect();
    setZoom(scale - 0.15, r.left + r.width / 2, r.top + r.height / 2);
  }
  function zoomResetHandler() {
    scale = 1; tx = -500; ty = -200; applyTransform();
  }

  function syncToViewport(e) {
    if (e.matches) attachInteractivity();
    else detachInteractivity();
  }
  syncToViewport(mq);
  mq.addEventListener('change', syncToViewport);
</script>

