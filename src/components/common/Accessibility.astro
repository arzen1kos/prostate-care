---
// SlideToggleButtons.astro
import ThemeToggle from '@components/common/ThemeToggle.astro';

// Glassy floating "+" button that slides out two controls:
//   1. Theme toggle (light / dark)
//   2. Body-text size slider (body copy only; layout widths never change)
//
// Props:
//   bodySelector: CSS selector for the text the slider should scale.
//   Anything outside this selector (nav, headings, buttons, widths) is untouched.
interface Props {
  bodySelector?: string;
}

const {
  bodySelector = "h1, h2, main p, main li, [data-body-text], welcome__intro h1",
} = Astro.props;

// Scales body text via rem, and forces long lines to wrap inside their own
// container, so a bigger font never widens the layout or causes sideways scroll.
const bodyTextCss = `
${bodySelector} {
  font-size: calc(1rem * var(--body-font-scale, 1));
  max-width: 100%;
  min-width: 0;
  overflow-wrap: anywhere;
  hyphens: auto;
  text-wrap: pretty;
}
:root[data-theme="dark"] { color-scheme: dark; }
:root[data-theme="light"] { color-scheme: light; }
`;
---

<!-- Apply saved theme + text size immediately to avoid a flash on load -->
<script is:inline>
  (function () {
    try {
      var root = document.documentElement;
      var theme = localStorage.getItem("theme");
      if (!theme) {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      root.setAttribute("data-theme", theme);
      var scale = parseFloat(localStorage.getItem("body-font-scale"));
      if (scale >= 0.8 && scale <= 1.5) {
        root.style.setProperty("--body-font-scale", String(scale));
      }
    } catch (e) {}
  })();
</script>

<style is:inline set:html={bodyTextCss}></style>
<!-- <div class="fab-set"> -->
  <div class="fab-group" data-fab-group>
    <!-- Main expander -->
    <button
      class="fab glass-violet"
      id="expandBtn"
      type="button"
      aria-label="Toggle actions"
      aria-expanded="false"
    >
      <img  src="/assets/svg/Accessibility-alt.svg" alt="Accessibility information"/>
    </button>
    <!-- Child #1: theme toggle -->
    <div class="fab-item" id="themeItem" inert>
      <ThemeToggle />
      <!-- <button
        class="fab fab-small glass-teal"
        id="themeBtn"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button> -->
    </div>
  
    <!-- Child #2: body text size slider (horizontal) -->
    <div class="fab-item" id="fontItem" inert>
      <div class="slider-panel glass-green" id="sliderPanel" role="group" aria-label="Body text size">
        <span class="a-small" aria-hidden="true">A</span>
        <div class="range-wrap">
          <input
            id="fontRange"
            type="range"
            min="80"
            max="150"
            step="2"
            value="10"
            aria-label="Body text size"
          />
        </div>
        <span class="a-large" aria-hidden="true">A</span>
        <button class="readout" id="fontReadout" type="button" title="Reset to 100%">100%</button>
      </div>
    </div>
  </div>

<style>
  /* ---------- Glass material ---------- */
  .glass-violet {
    --tint: 92, 77, 125;
  }
  .glass-teal {
    --tint: 70, 140, 135;
  }
  .glass-green {
    --tint: 70, 150, 110;
  }

  .fab-set {
  /* .slider-panel { */
    background-color: aqua;
/* 
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.38), rgba(255, 255, 255, 0.06)),
      rgba(var(--tint), 0.42);
    -webkit-backdrop-filter: blur(14px) saturate(170%); */
    backdrop-filter: blur(14px) saturate(170%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow:
      0 8px 24px rgba(31, 38, 70, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.65),
      inset 0 -1px 0 rgba(255, 255, 255, 0.12);
  }

  /* ---------- Floating buttons ---------- */
  .fab {
    font-size: 2.5em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
    outline: none;
    border-radius: 10%;
    width: var(--main);
    height: var(--main);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.5s ease, background 0.3s ease;
    user-select: none;
  }
  .fab:hover {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.12)),
      rgba(var(--tint), 0.5);
  }
  .fab:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.9);
    outline-offset: 2px;
  }

  /* Child buttons are smaller than the main button */
  .fab-small {
    width: var(--child);
    height: var(--child);
    font-size: 1.75em;
  }

  /* The group is the only fixed element (bottom-right). It is exactly the size
     of the main button, and the child items are positioned relative to it. */
  .fab-group {
    --main: 50px; /* main button size */
    --child: 46px; /* child item size */
    --gap: 20px; /* space between main button, theme button and slider */
    position: relative;
    /* top: 0; */
    /* right: 0; */
    /* margin: 4vh; */
    width: var(--main);
    height: var(--main);
  }

  #expandBtn {
    position: relative;
    background-color: #070346;
    color: #fff;
    padding: 0.35rem;
    z-index: 10;
  }

  /* Closed: each child sits centred behind the main button.
     Open: it slides up by a distance derived from --main, --child and --gap. */
  .fab-item {
    position: absolute;
    top: calc((var(--main) - var(--child)) / 2);
    left: calc((var(--main) - var(--child)) / 2);
    width: var(--child);
    height: var(--child);
    z-index: 1;
    transition: transform 0.5s ease;
  }

  /* ---------- Icons ---------- */
  .icon {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
  }
  /* Light mode shows the moon (click for dark); dark mode shows the sun (click for light) */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: block;
  }
  :global(:root[data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }

  /* ---------- Slider panel (the child item itself: a vertical pill,
     horizontally centred over the main button's column, growing upward) ---------- */
  .slider-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--child);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    /* padding: 0.9rem 0; */
    border-radius: 9px;
    /* color: #fff; */
    /* text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3); */
    /* Hidden while collapsed so it doesn't peek out from behind the + button */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .fab-group.open .slider-panel {
    opacity: 1;
    pointer-events: auto;
  }

  /* Vertical slider: a horizontal input rotated -90deg (max at top, min at bottom).
     The wrapper reserves the space the rotated input occupies. */
  .range-wrap {
    --range-len: clamp(4rem, 16vh, 7rem);
    position: relative;
    flex: none;
    width: 1.5rem;
    height: var(--range-len);
  }
  .slider-panel input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    writing-mode: horizontal-tb;
    direction: ltr;
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--range-len);
    height: 1.5rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .slider-panel input[type="range"]::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
  }
  .slider-panel input[type="range"]::-moz-range-track {
    height: 6px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.45);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
  }
  .slider-panel input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    margin-top: -7px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }
  .slider-panel input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }
  .slider-panel input[type="range"]:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 4px;
    border-radius: 999px;
  }

  .a-small {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .a-large {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .readout {
    font: inherit;
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    padding: 0.15rem 1.4rem;
    /* border: 1px solid rgba(255, 255, 255, 0.6); */
    /* border-radius: 999px; */
    /* background: rgba(255, 255, 255, 0.18); */
    color: inherit;
    text-shadow: inherit;
    cursor: pointer;
  }
  .readout:hover {
    /* background: rgba(255, 255, 255, 0.32); */
  }

  /* ---------- Open state ---------- */
  .fab-group.open #expandBtn {
    transform: rotate(-360deg);
  }
  /* Theme button: one --gap above the main button */
  .fab-group.open #themeItem {
    transform: translateY(calc(1 * ((var(--main) + var(--child)) / 2 + var(--gap))));
  }
  /* Slider: one --gap above the theme button (its panel grows upward from here) */
  .fab-group.open #fontItem {
    transform: translateY(
      calc(1 * ((var(--main) + var(--child)) / 2 + var(--gap) + var(--child) + var(--gap)))
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .fab,
    .fab-item,
    .slider-panel {
      transition: none;
    }
  }
</style>

<script>
  const root = document.documentElement;

  const safeGet = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const safeSet = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {}
  };

  document.querySelectorAll<HTMLElement>("[data-fab-group]").forEach((group) => {
    const expandBtn = group.querySelector<HTMLButtonElement>("#expandBtn")!;
    const items = group.querySelectorAll<HTMLElement>(".fab-item");

    const themeBtn = group.querySelector<HTMLButtonElement>("#themeBtn")!;

    const range = group.querySelector<HTMLInputElement>("#fontRange")!;
    const readout = group.querySelector<HTMLButtonElement>("#fontReadout")!;

    /* ----- Expand / collapse ----- */
    const setOpen = (open: boolean) => {
      group.classList.toggle("open", open);
      expandBtn.setAttribute("aria-expanded", String(open));
      items.forEach((item) => (item.inert = !open));
    };

    /* ----- Theme ----- */
    // const syncThemeButton = () => {
    //   const dark = root.getAttribute("data-theme") === "dark";
    //   themeBtn.setAttribute("aria-pressed", String(dark));
    //   themeBtn.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    // };

    // themeBtn.addEventListener("click", () => {
    //   const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    //   root.setAttribute("data-theme", next);
    //   safeSet("theme", next);
    //   syncThemeButton();
    //   window.dispatchEvent(new CustomEvent("themechange", { detail: { theme: next } }));
    // });
    // syncThemeButton();
    document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    
    // Check for saved theme preference or use OS preference
    const getThemePreference = () => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    
    // Apply the current theme
    const applyTheme = (theme: any) => {
        const darkLogo  = '/assets/logo/prometheus-app-logo-for-dark.png';
        const lightLogo = '/assets/logo/prometheus-app-logo.png'; // Change this to your dark logo path
        const logo = document.getElementById('site-logo');
        
        const themeToggleBtn = document.getElementById('theme-toggle');
        const lightIcon = document.getElementById('theme-toggle-light-icon');
        const darkIcon = document.getElementById('theme-toggle-dark-icon');

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');

        darkIcon?.classList.add('hidden');
        lightIcon?.classList.remove('hidden');
        
        if (logo instanceof HTMLImageElement) {
          logo.src = darkLogo;
        }

      } else {
        document.documentElement.classList.remove('dark');

        darkIcon?.classList.remove('hidden');
        lightIcon?.classList.add('hidden');

        if (logo instanceof HTMLImageElement) {
          logo.src = lightLogo;
        }
      }
      
    };
    
    // Initialize theme
    const currentTheme = getThemePreference();
    applyTheme(currentTheme);
    
    // Toggle theme on click
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      const newTheme = isDark ? 'light' : 'dark';
      
      // Save preference
      localStorage.setItem('theme', newTheme);
      
      // Apply new theme
      applyTheme(newTheme);
    });
  });

    /* ----- Body text size ----- */
    const applyScale = (percent: number) => {
      root.style.setProperty("--body-font-scale", String(percent / 100));
      range.value = String(percent);
      readout.textContent = `${percent}%`;
      range.setAttribute("aria-valuetext", `${percent} percent`);
    };

    const saved = parseFloat(safeGet("body-font-scale") ?? "");
    applyScale(saved >= 0.8 && saved <= 1.5 ? Math.round(saved * 100) : 100);

    range.addEventListener("input", () => {
      const percent = Number(range.value);
      applyScale(percent);
      safeSet("body-font-scale", String(percent / 100));
    });

    readout.addEventListener("click", () => {
      applyScale(100);
      safeSet("body-font-scale", "1");
    });

    /* ----- Main button, Escape ----- */
    expandBtn.addEventListener("click", () => {
      setOpen(!group.classList.contains("open"));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && group.classList.contains("open")) {
        setOpen(false);
        expandBtn.focus();
      }
    });
  });
</script>