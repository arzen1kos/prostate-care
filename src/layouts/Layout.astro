---
import Footer from './Footer.astro';
import Header from './Header.astro';
import '@styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'BlueprintNZ - Modern web solutions' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/prometheus-app-logo.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Theme script to prevent flash of wrong theme -->
    <script is:inline>
      // Check for saved theme preference or use system preference
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'dark' : 'light';
      };
      
      // Apply theme immediately to prevent flash
      const theme = getThemePreference();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- <Header label="Home" href="/" icon="home" /> -->
    <Header title={title} showBrand={!title.startsWith("Welcome")} />

    <!-- <Breadcrumbs items={breadcrumbItems} /> -->

    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <!-- <BackToTop /> -->
    <button
      id="scrollToTop"
      class="fixed bottom-6 right-6 z-50 bg-[var(--color-palette-four)] text-[var(--color-palette-one)] px-4 py-3 rounded-sm shadow-lg hover:bg-[var(--color-palette-four)] transition-opacity duration-300 opacity-0 pointer-events-none"
      aria-label="Scroll to top"
    >
      ↑
    </button>

  </body>
</html>
<script>
</script>
