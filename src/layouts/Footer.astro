---
import { footerLinks } from '@contents/common/footer';
import Form from '@components/ui/Form.astro';
import Icon from '@components/ui/Icon.astro';

---

<footer class="w-full border-t border-secondary/20 bg-secondary dark:bg-gray-900" style={`
`}>
  <div class="container mx-auto max-w-[2000px]">
    <nav aria-label="Secondary" class="flex flex-col lg:flex-row justify-between gap-10 lg:gap-16 pt-6">
      <!-- Newsletter Section -->
      <Form 
        title={footerLinks.newsletterSection.title}
        description={footerLinks.newsletterSection.description}
        placeholder={footerLinks.newsletterSection.placeholder}
        buttonText={footerLinks.newsletterSection.buttonText}
      />
      
      <!-- Footer Sections -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 sm:gap-10">
        {footerLinks.sections.map((section, index) => (
          <div>
            <h3 class="text-sm font-semibold text-white mb-3">{section.title}</h3>
            <ul class="space-y-2">
              {section.links.map(link => (
                <li>
                  <a href={link.url} class="text-xs text-neutral/80 dark:text-gray-300 hover:text-white transition-colors">
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>
    
    <hr class="border-primary/30 my-6" style="border-color: var(--color-palette-four);">
    
    <div class="flex flex-col md:flex-row items-center gap-4">
      <div class="text-xs text-center md:text-left" style="color: var(--color-palette-gray);">
        {footerLinks.copyright}
      </div>
      <div class="flex space-x-4">
        {footerLinks.socialLinks.map(link => (
          <a 
            href={link.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-neutral/80 hover:text-white transition-colors"
            aria-label={link.platform}
          >
            <Icon name={link.platform.toLowerCase()} size={20} color="var(--color-palette-gray)"/>
          </a>
        ))}
      </div>

    </div>
  </div>
</footer>

<style>
  footer .container{
    margin-top: 2rem;
    /* padding-top: 2rem; */
    padding-bottom: 2rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  @media (min-width: 640px) {
    footer .container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    footer .container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  /* footer hr {
    padding-top: 2.5rem;
    padding-bottom: 0.5rem;
  } */
</style>