---
import FontSizeToggle from '@components/common/FontSizeToggle.astro';
import ThemeToggle from '@components/common/ThemeToggle.astro';
import ChatBox from '@components/common/ChatBox.astro';
import { mainNavItems } from '@contents/common/navigation';

interface Props {
  title: string;
  showBrand?: boolean;
}

const { title, showBrand = true } = Astro.props;
const brandTitle = title.split('|')[0].trim();
// const linksById = new Map(primaryNavigation.map(({ id, href }) => [id, href]));
---

<header class="site-header sticky top-0 mb-5 py-3 z-40 w-full">
  <div class=`container mx-auto px-10 md:px-6 lg:px-8 max-w-[2000px] flex items-center h-20`>
    <!-- Logo (left) - Size from centralized file -->
    <div class="site-header__inner">
      {showBrand && (
        <a class="site-brand" href="/welcome" aria-label="Prometheus home">
          <img src="/assets/logo/prometheus-app-logo.png" alt="" width="54" height="54" />
          <span class="site-brand__text">
            <strong>{brandTitle}</strong>
            <span>Prostate Cancer Support Website</span>
          </span>
        </a>
      )}
    </div>
    <!-- Right Navigation Items -->
    <div class={`flex items-center py-2 gap-4`}>
        {mainNavItems.map(item => (
          <FontSizeToggle {...item} />
        ))}
        <div class={`flex items-center space-x-1 sm:space-x-8`}>
          <ThemeToggle />
        </div>
        <ChatBox />
      </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    
    // Check for saved theme preference or use OS preference
    const getThemePreference = () => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    
    // Apply the current theme
    const applyTheme = (theme: any) => {
        const darkLogo  = '/assets/logo/prometheus-app-logo-for-dark.png';
        const lightLogo = '/assets/logo/prometheus-app-logo.png'; // Change this to your dark logo path
        const logo = document.getElementById('site-logo');
        
        const themeToggleBtn = document.getElementById('theme-toggle');
        const lightIcon = document.getElementById('theme-toggle-light-icon');
        const darkIcon = document.getElementById('theme-toggle-dark-icon');

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');

        darkIcon?.classList.add('hidden');
        lightIcon?.classList.remove('hidden');
        
        if (logo instanceof HTMLImageElement) {
          logo.src = darkLogo;
        }

      } else {
        document.documentElement.classList.remove('dark');

        darkIcon?.classList.remove('hidden');
        lightIcon?.classList.add('hidden');

        if (logo instanceof HTMLImageElement) {
          logo.src = lightLogo;
        }
      }
      
    };
    
    // Initialize theme
    const currentTheme = getThemePreference();
    applyTheme(currentTheme);
    
    // Toggle theme on click
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      const newTheme = isDark ? 'light' : 'dark';
      
      // Save preference
      localStorage.setItem('theme', newTheme);
      
      // Apply new theme
      applyTheme(newTheme);
    });
  });
</script>

<style>
  .site-header {
    /* display: flex; */
    /* width: 100%; */
    /* justify-content: flex-end; */
    position: relative;
    z-index: 20;
    background: none;
  }

  .site-header__inner {
    display: flex;
    width: min(100% - 2.5rem, 82rem);
    min-height: 6.5rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-indigo);
    text-decoration: none;
  }

  .site-brand img {
    display: block;
    width: 3.4rem;
    height: 3.4rem;
    object-fit: contain;
  }

  .site-brand__text,
  .site-brand__text span {
    display: block;
  }

  .site-brand__text strong {
    font-size: clamp(0.95rem, 2vw, 1.35rem);
    font-weight: 850;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .site-brand__text span {
    margin-top: 0.2rem;
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }

  .quick-links {
    display: flex;
    align-items: center;
    margin-left: auto;
    justify-content: flex-end;
    gap: clamp(0.65rem, 2.2vw, 1.75rem);
  }

  .quick-link {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border-radius: 20%;
  }

  .quick-link img {
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.6;
  }

  .quick-link:hover {
    background: var(--color-lavender);
    opacity: 1;
  }

  .accessibility-container {
    display: 'flex';
    position: 'relative';
    flex-direction: column;
    align-items: flex-start;
  }

  @media (max-width: 560px) {
    .site-header__inner {
      width: min(100% - 1.25rem, 82rem);
      min-height: 5.2rem;
      gap: 0.5rem;
    }

    .site-brand {
      gap: 0.45rem;
    }

    .site-brand img {
      width: 2.6rem;
      height: 2.6rem;
    }

    .site-brand__text span {
      max-width: 8.5rem;
      font-size: 0.72rem;
    }

    .quick-links {
      gap: 0.2rem;
    }

    .quick-link {
      width: 2.1rem;
      height: 2.1rem;
    }

    .quick-link img {
      width: 1.35rem;
      height: 1.35rem;
    }
  }
</style>
