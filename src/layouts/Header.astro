---
import Accessibility from '@components/common/Accessibility.astro';
import ChatBox from '@components/common/ChatBox.astro';
// import { mainNavItems } from '@contents/common/navigation';
interface Props {
  title: string;
  showBrand?: boolean;
}

const { title, showBrand = true } = Astro.props;
const brandTitle = title.split('|')[0].trim();
// const linksById = new Map(primaryNavigation.map(({ id, href }) => [id, href]));
---

<header class="site-header sticky top-0 mb-5 py-3 z-40 w-full">
  <div class=`container mx-auto px-10 md:px-6 lg:px-2 max-w-[2000px] flex items-start h-20`>
    <!-- Logo (left) - Size from centralized file -->
    <div class="site-header__inner">
      {showBrand && (
        <a class="site-brand" href="/welcome" aria-label="Prometheus home">
          <img src="/assets/logo/prometheus-app-logo.png" alt="" width="54" height="54" />
          <span class="site-brand__text">
            <strong>{brandTitle}</strong>
            <span>Prostate Cancer Support Website</span>
          </span>
        </a>
      )}
    </div>
    <!-- Right Navigation Items -->
     <nav class="quick-links" aria-label="Quick links">
      <a class="quick-link" href="/clinics" aria-label="Find a clinic" title="Clinics">
        <!-- {linksById.get('clinics')} -->
        <img src="/assets/svg/Clinic.svg" alt=""/>
      </a>
      <a class="quick-link" href="/site-map" aria-label="Open site map" title="Site map">
        <!-- {linksById.get('site-map')} -->
        <img src="/assets/svg/Sitemap-outline.svg" alt=""/>
      </a>
      <div class={`flex flex-col-reverse items-center`}>
          <ChatBox />
        </div>
        <Accessibility />
    </nav>
  </div>
</header>

<style>
  .site-header {
    /* display: flex; */
    /* width: 100%; */
    /* justify-content: flex-end; */
    position: relative;
    z-index: 20;
    background: none;
  }

  .site-header__inner, nav {
    display: flex;
    width: min(100% - 2.5rem, 82rem);
    min-height: 4.5rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-indigo);
    text-decoration: none;
  }

  .site-brand img {
    display: block;
    width: 3.4rem;
    height: 3.4rem;
    object-fit: contain;
  }

  .site-brand__text,
  .site-brand__text span {
    display: block;
  }

  .site-brand__text strong {
    font-size: clamp(0.95rem, 2vw, 1.35rem);
    font-weight: 850;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .site-brand__text span {
    margin-top: 0.2rem;
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }

  .quick-links {
    display: flex;
    /* align-items: center; */
    margin-left: auto;
    justify-content: flex-end;
    gap: clamp(0.65rem, 2.2vw, 0.75rem);
    padding: 0 1.2rem;
  }

  .quick-link {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border-radius: 20%;
  }

  .quick-link img {
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.6;
  }

  .quick-link:hover {
    background: var(--color-lavender);
    opacity: 1;
  }

  .accessibility-container {
    display: flex;
    flex-direction: column-reverse;
    position: relative;
    align-items: center;
    /* padding: 2rem 0; */
    gap: 4;
  }

  @media (max-width: 560px) {
    .site-header__inner {
      width: min(100% - 1.25rem, 82rem);
      min-height: 5.2rem;
      gap: 0.5rem;
    }

    .site-brand {
      gap: 0.45rem;
    }

    .site-brand img {
      width: 2.6rem;
      height: 2.6rem;
    }

    .site-brand__text span {
      max-width: 8.5rem;
      font-size: 0.72rem;
    }

    .quick-links {
      gap: 0.2rem;
    }

    .quick-link {
      width: 2.1rem;
      height: 2.1rem;
    }

    .quick-link img {
      width: 1.35rem;
      height: 1.35rem;
    }
  }
</style>
