---
import SearchBar from '@components/research/SearchBar.tsx';

interface HubCard {
  title: string;
  description: string;
  href?: string;
}

interface HubContent {
  title: string;
  heading: string;
  description: string;
  breadcrumbs: Array<{ label: string; href: string; current: boolean }>;
  illustration: string;
  sections: Array<{ heading: string; cards: HubCard[] }>;
  notice?: string;
  browseLinks?: Array<{ label: string; href: string }>;
}

interface Props {
  content: HubContent;
}

const { content } = Astro.props;
const currentBreadcrumb = content.breadcrumbs[content.breadcrumbs.length - 1];
---

<section class="hub">
  <div class="hub__content">
    <div class="hub__hero-inner">
      <div class="hub__copy">
        <nav aria-label="Breadcrumb">
          <a href="/welcome">Home</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{currentBreadcrumb?.label ?? content.title}</span>
        </nav>
        <h1>{content.heading}</h1>
        <p>{content.description}</p>
        {content.title.toLowerCase().includes('research') && (
          <SearchBar query="" setQuery={() => {}} />
        )}
      </div>
      <img class="hub__illustration" src={content.illustration} alt="" />
    </div>
    <slot/>
  </div>
</section>

<style>
  .hub {
    min-height: 70vh;
    color: var(--color-navy);
  }

  .hub__content {
    width: min(100% - 9em, 84rem);
    margin-inline: auto;
    /* background-color: #4f708f54; */
    /* padding: clamp(2.5rem, 5vw, 4rem) 0 2rem; */
  }

  .hub__hero-inner {
    display: grid;
    width: min(100% - 2.5rem, 76rem);
    min-height: 14rem;
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 15rem);
    align-items: center;
    gap: 2rem;
    /* padding-block: clamp(1.5rem, 3vw, 2.5rem); */
  }

    /* .hub__hero > div {
    position: relative;
    padding-right: min(22vw, 16rem);
  } */


  .hub__copy :global(nav) {
    display: flex;
    gap: 0.45rem;
    color: var(--color-indigo);
    font-size: 0.8rem;

    /* position: relative;
    padding-right: min(22vw, 16rem);
    margin-bottom: 0.6rem;
    color: var(--color-indigo);
    font-size: 0.78rem; */
  }

  .hub__copy h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.8rem, 3.5vw, 2.65rem);
    font-weight: 800;
    line-height: 1.08;

    /* margin: 0;
    color: var(--color-navy);
    font-size: clamp(1.8rem, 3.4vw, 2.65rem);
    font-weight: 800;
    line-height: 1.12; */
  }

  .hub__copy p {
    max-width: 45rem;
    margin: 0.7rem 0 0;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;

    /* max-width: 47rem;
    margin: 0.8rem 0 0;
    color: var(--color-ink-muted);
    line-height: 1.55; */
  }
  
  .pathub__copy > div > img {
    position: absolute;
    top: 1rem;
    right: 0;
  }

  .hub__illustration {
    width: min(17vw, 12rem);
    /* height: 10rem; */
    object-fit: contain;
    /* width: 100%;
    max-height: 11rem;
    object-fit: contain; */
  }

  .hub__hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    border-radius: 0.3rem;
    padding: 0.55rem 0.75rem;
    background: var(--color-navy);
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }


  @media (max-width: 620px) {
    .hub__hero-inner {
      width: var(--width-content);
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .pathub__copy > div > img {
    /* .hub__illustration { */
      width: 8rem;
      max-height: 7rem;
      justify-self: end;
      grid-row: 1;
    }
  }
</style>
