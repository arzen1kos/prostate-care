---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-caregiver-content.ts';
import Icon from '../../components/ui/Icon.astro';

const {
    heading = content['caregiver'].heading3.title,
    title = `Stage ${content['caregiver'].heading3.stageNum} - ${heading} | BluePrintNZ`,
    description = content['caregiver'].heading3.description,
    main = content['caregiver'].heading3.main,
    // link = content["caregiver"].heading3.description,
    breadcrumb = content['caregiver'].heading3.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---

<Layout title=`${title}`>
    <div class="container mx-auto px-4 pt-10 pb-25">
        <!-- 🧩 Header Component -->
        <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />

        <span class="subheadings flex gap-3">
            {main.x.subheading}
            <a href=`${main.x.link}`>
                <!-- <div class="p-3 rounded-full w-15 h-15 flex items-center justify-center mb-4" style="background: var(--color-palette-one);"> -->
                <Icon class="card-icon" name="external-link" color="var(--color-palette-five)" />
                <!-- </div> -->
            </a>
        </span>
        <p class="pt-2">{main.x.body[0]}</p>
        <!-- <p class="pt-2">{main.x.body[1]}</p> -->
        <!-- <ul>
            {main.x.body[2].items.map((item, i) => <li class="pt-2 pl-4">{`- ${item}`}</li>)}
        </ul> -->
    </div>
</Layout>
<script></script>
