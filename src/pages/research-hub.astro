---
import Layout from '@layouts/Layout.astro';
import HubLanding from '@layouts/HubLanding.astro';
import { getCollection, getEntry } from "astro:content";
import researchTaxonomy from '@contents/taxonomy/research-tags.json';
import ResearchLibrary from '@components/research/ResearchLibrary.tsx';
import SearchBar from '@components/ui/SearchBar.tsx';

const page = await getEntry("hubPages", "research");
if (!page) throw new Error("Missing hub page content: research");
const content = page.data;
const researchTagIds = new Set([
  "clinical-trials",
  "pharmacology",
  "radiotherapy",
  "nutrition-epidemiology",
  "biomarkers-immunology",
  "exercise-rehabilitation",
  "registry-outcomes",
]);
const seenSources = new Set<string>();
const researchEntries = (await getCollection("research"))
  .filter(({ data}) => data.tags.some((tag) => researchTagIds.has(tag)))
  .filter(({ data }) => {
    if (seenSources.has(data.source_sha256)) return false;
    seenSources.add(data.source_sha256);
    return true;
  })
  .sort(
    (left, right) =>
      (right.data.publish_year ?? 0) - (left.data.publish_year ?? 0),
  );
const researchTopics = researchTaxonomy
  .filter(({ id }) => researchTagIds.has(id))
  .map(({ id, label }) => ({ id, label }));
const researchRecords = researchEntries.map(({ data }) => ({
  document_id: data.document_id,
  title: data.title,
  publish_year: data.publish_year,
  document_type: data.document_type,
  journal_or_publisher: data.journal_or_publisher,
  authors: data.authors,
  tags: data.tags,
  classification_confidence: data.classification_confidence,
}));
---

<Layout
  title={`${content.title} | Prostate Cancer Foundation NZ`}
  description={content.description}
>
  <div>
    <HubLanding content={content}>
      <ResearchLibrary
        client:load
        entries={researchRecords}
        topics={researchTopics}
      />
      {content.notice && <p class="hub__notice">{content.notice}</p>}
      {content.browseLinks && (
        <nav class="hub__browse" aria-label="More research pages">
          {content.browseLinks.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}
        </nav>
      )}
    </HubLanding>
  </div>
</Layout>

