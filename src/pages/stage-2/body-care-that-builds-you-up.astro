---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-stage-2.ts';
import Icon from '../../components/ui/Icon.astro';

const {
    heading = content['stage-2'].heading2.title,
    title = `Stage ${content['stage-2'].heading2.stageNum} - ${heading} | BluePrintNZ`,
    description = content['stage-2'].heading2.description,
    main = content['stage-2'].heading2.main,
    // link = content["stage-2"].heading2.description,
    breadcrumb = content['stage-2'].heading2.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---

<Layout title=`${title}`>
    <div class="container mx-auto px-4 pt-10 pb-25">
        <!-- 🧩 Header Component -->
        <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />
        <span class="subheadings flex gap-3">
            <strong>{main.KegelIntro.subheading}</strong>
            <!-- <a href=`${main.x.link}`>
                <Icon class="card-icon" name="external-link" color="var(--color-palette-five)" />
            </a> -->
        </span>
        <p class="pt-2">{main.KegelIntro.description}</p>
        <div class="w-full flex flex-col md:flex-row gap-10 max-w-6xl mx-auto px-4 mt-20 items-center">
            <div class="md:w-1/2 w-full flex justify-center">
                <img 
                src={main.KegelIntro.kegelImage} 
                alt={`Kegel exercise illustration: ${main.KegelIntro.alt} `}
                class="w-full max-w-md md:max-w-full h-auto object-contain"
                loading="lazy"
                />
            </div>

            <div class="md:w-1/2 w-full space-y-6">
                {[
                "Identify the muscles: Try stopping urination midstream—that's your pelvic floor.",
                "Contract: Squeeze and hold for 3–5 seconds, then release.",
                "Repeat: Do 10 reps, 2–3 times a day.",
                "Consistency matters: Do them daily for best results.",
                ].map((step, i) => (
                <div class="flex items-start gap-4 px-20 md:px-10">
                    <div class="min-w-[2rem] min-h-[2rem] flex items-center justify-center bg-[var(--color-palette-accent)] text-[var(--color-palette-one)] rounded-full font-bold text-sm shadow">
                    {i + 1}
                    </div>
                    <p class="text-base md:text-lg leading-relaxed text-[var(--color-palette-five)]">
                    {step}
                    </p>
                </div>
                ))}
                <hr>
                <div class="mt-10">
                <h6>
                    <strong>Want a step-by-step walkthrough? Watch our detailed demo video{' '}
                    <a href={main.KegelIntro.link} target="_blank" rel="noopener noreferrer">here</a>!</strong>
                </h6>
                <a href={main.KegelIntro.link} target="_blank" rel="noopener noreferrer">
                    <img
                    src={main.KegelIntro.thumbnail} 
                    alt="Demo Video Thumbnail"
                    style={{ cursor: 'pointer', maxWidth: '100%', height: 'auto', marginTop: '8px' }}
                    />
                </a>
                </div>
            </div>
        </div>


        <!-- <ul>
            {main.x.body[2].items.map((item, i) => <li class="pt-2 pl-4">{`- ${item}`}</li>)}
        </ul> -->
    </div>
</Layout>
<script></script>
