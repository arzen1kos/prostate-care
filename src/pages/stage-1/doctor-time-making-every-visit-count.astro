---
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-stage-1.ts';

const {
  heading = content['stage-1'].heading2.title,
  title = `Stage ${content['stage-1'].heading2.stageNum} - ${heading} | BluePrintNZ`,
  description = content['stage-1'].heading2.description,
  main = content['stage-1'].heading2.main,
  breadcrumb = content['stage-1'].heading2.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---

<Layout title={title}>
  <div class="container mx-auto px-4 pt-10 pb-25">
    <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />
    <section class="max-w-6xl mx-auto px-4 py-10">
      <h2 class="text-3xl font-extrabold mb-6 text-[var(--color-palette-five)] tracking-tight text-center">
        Questions to Ask Your Doctor
        <br />
        <span class="text-xl font-light italic text-[var(--color-palette-four)]">Pātai Hei Pātai ki tō Rātā</span>
      </h2>

      <div
        id="carousel"
        class="overflow-x-auto snap-x snap-mandatory flex gap-6 pb-6 scrollbar-hide"
        style="scroll-behavior: smooth;"
        aria-label="Question carousel"
      >
        {main.questions.body[0].items.map(({ en, mi }, i) => (
          <div
            key={i}
            class="snap-start flex-shrink-0 w-80 bg-[var(--color-palette-two)] rounded-lg shadow-md p-6 flex flex-col justify-between hover:shadow-xl transition-shadow duration-300"
            role="group"
            aria-label={`Question ${i + 1}`}
          >
            <p class="text-lg font-semibold text-[var(--color-palette-five)] mb-4 leading-snug">{en}</p>
            <p class="text-base font-light italic text-[var(--color-palette-four)] leading-relaxed">{mi}</p>
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-[var(--color-palette-four)] mt-2">
        Scroll horizontally &nbsp;<span aria-hidden="true">→</span>
      </p>
    </section>
    <p class="text-center mx-10 md:mx-15 lg:mx-80">We know doctor visits can feel overwhelming. This carousel guides you gently through important questions and info—helping you feel supported and in control every step of the way.</p>
  </div>
</Layout>

 <script type="module" is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const carousel = document.getElementById('carousel');
      let scrollAmount = 0;
      const scrollStep = 1;
      const scrollInterval = 20;

      function autoScroll() {
        if (!carousel) return;

        scrollAmount += scrollStep;

        if (scrollAmount >= carousel.scrollWidth - carousel.clientWidth) {
          scrollAmount = 0;
        }
        carousel.scrollLeft = scrollAmount;
      }

      let intervalId = setInterval(autoScroll, scrollInterval);

      carousel.addEventListener('mouseenter', () => clearInterval(intervalId));
      carousel.addEventListener('mouseleave', () => {
        intervalId = setInterval(autoScroll, scrollInterval);
      });
    });
  </script>

  <style>
    /* For WebKit browsers (Chrome, Edge, Safari) */
.carousel-container::-webkit-scrollbar {
  height: 8px;
}

.carousel-container::-webkit-scrollbar-track {
  background: var(--color-palette-two); /* neutral track */
}

.carousel-container::-webkit-scrollbar-thumb {
  background-color: var(--color-palette-three); /* visible thumb */
  border-radius: 0; /* make it rectangular */
}

.carousel-container::-webkit-scrollbar-thumb:hover {
  background-color: var(--color-palette-four);
}

/* For Firefox */
.carousel-container {
  scrollbar-width: thin;
  scrollbar-color: var(--color-palette-three) var(--color-palette-two);
}
</style>