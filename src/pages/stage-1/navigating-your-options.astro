---
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-stage-1.ts';
import Icon from '../../components/ui/Icon.astro';

const {
    heading = content['stage-1'].heading3.title,
    title = `Stage ${content['stage-1'].heading3.stageNum} - ${heading} | BluePrintNZ`,
    description = content['stage-1'].heading3.description,
    main = content['stage-1'].heading3.main,
    breadcrumb = content['stage-1'].heading3.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---

<Layout title={`${title}`}>
  <section class="container mx-auto px-4 pt-12 pb-24">
    <!-- 🧩 Page Heading -->
    <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />

    <!-- Subheading & Link Card -->
    <div class="mt-10 rounded-2xl border-l-8 pl-6 pr-4 py-4 shadow-md bg-[var(--color-palette-five)] backdrop-blur-md"
         style="border-color: var(--color-palette-one)">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold" style="color: var(--color-palette-one)">
          {main.x.subheading}
        </h2>
        <a href={`${main.x.link}`} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center justify-center p-2 rounded-full hover:scale-110 transition"
           style="background: var(--color-palette-one)">
          <Icon name="external-link" class="w-5 h-5 text-[var(--color-palette-three)]"/>
        </a>
      </div>
      <!-- Intro Paragraphs -->
      <div class="mt-2 text-base leading-relaxed">
        <p class="pl-10 text-[var(--color-palette-two)]">{main.x.body[0]}</p>
        <p class="pl-10 text-[var(--color-palette-two)]">{main.x.body[1]}</p>
      </div>
    </div>


    <!-- 💊 Bullet Cards -->
    <div class="mt-10 grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {main.x.body[2].items.map((item, i) => (
        <div
          class="rounded-xl overflow-hidden shadow-lg p-3 flex flex-col transition hover:shadow-xl"
          style="border-color: var(--color-palette-three)"
        >
          <img
            src={item.image}
            alt={item.alt}
            class="w-full h-48 object-cover"
          />
          <div class="p-4 flex-1 flex flex-col justify-between">
            <p class="text-sm font-medium" style="color: var(--color-palette-five)">
              {item.detail}
            </p>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <a href="#" class="text-sm font-medium" style="color: var(--color-palette-four)">
              Learn More
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
