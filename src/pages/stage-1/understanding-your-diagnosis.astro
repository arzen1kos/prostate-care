---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-stage-1.ts';
import Icon from '../../components/ui/Icon.astro';

const {
    heading = content['stage-1'].heading1.title,
    title = `Stage ${content['stage-1'].heading1.stageNum} - ${heading} | BluePrintNZ`,
    description = content['stage-1'].heading1.description,
    main = content['stage-1'].heading1.main,
    // link = content["stage-1"].heading1.description,
    breadcrumb = content['stage-1'].heading1.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---

<Layout title=`${title}`>
    <div class="container mx-auto px-4 pt-10 pb-25">
        <!-- 🧩 Header Component -->
        <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />

        <span class="subheadings flex gap-3">
            {main.Gleason.subheading}
            <!-- <a href=`${main.x.link}`>
                <Icon class="card-icon" name="external-link" color="var(--color-palette-five)" />
            </a> -->
        </span>
        <p class="pt-2">{main.Gleason.body}</p>
        <img 
            src={main.Gleason.image}
            alte={main.Gleason.link}
        />
        <p></p>
        <!-- <ul>
            {main.Gleason.body[2].items.map((item, i) => <li class="pt-2 pl-4">{`- ${item}`}</li>)}
        </ul> -->
    </div>
</Layout>
<script></script>
