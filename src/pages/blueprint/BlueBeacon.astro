---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
// import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { blueBeaconClinics, blueBeaconGroups } from '../../content/blueindex/bluebeacon.ts';

const breadcrumbItems = [
  { label: 'Blueprint', link: '/blueprint', current: false },
  { label: 'BlueBeacon', link: '/blueprint/bluebeacon', current: true }
];

const {
  heading = "BlueBeacon",
  title = `BlueBeacon | BluePrintNZ`,
  description = ["➤ Locate clinics, support groups, and resources near you for care and community."],
  // main = content['stage-1'].heading2.main,
  // breadcrumb = content['stage-1'].heading2.breadcrumbs
} = Astro.props;
---

<Layout title={title}>
  <div class="container mx-auto px-5 md:px-25 pt-10 pb-25">
    <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />
    <h2>Clinics</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-6">
      {blueBeaconClinics.map(({ name, description, thumbnail, address, phone, link }, i) => (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full max-w-sm rounded-xl overflow-hidden shadow-md bg-[var(--color-palette-four)] hover:shadow-lg transition-shadow duration-300 no-underline"
          aria-label={`Open Google Maps for ${name}`}
        >
          <div class="h-40 w-full bg-gray-800">
            <img
              src={thumbnail}
              alt={`Map thumbnail for ${name}`}
              class="w-full h-full object-cover"
            />
          </div>
          {/* <!-- Card content --> */}
          <div class="p-4">
            <h3 class="text-lg font-bold text-[var(--color-palette-one)] mb-1">{name || 'Location Name'}</h3>
            <p class="text-md font-semibold text-[var(--color-palette-two)] mb-1">{description || 'Location Description'}</p>
            <p class="text-sm text-[var(--color-palette-two)] whitespace-pre-line">
              {address.join('\n')}
            </p>
            {phone && (
              <p class="text-sm text-[var(--color-palette-two)] mt-2">📞 {phone}</p>
            )}
          </div>
        </a>
      ))}
    </div>

    <hr class="my-10 border-t border-[var(--color-palette-gray)]" />

    <h2>Support Groups</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-8">
      {blueBeaconGroups.map((group) => (
        <div class="bg-white shadow-md rounded-xl border border-neutral-200 p-6 flex flex-col justify-between hover:shadow-lg transition-all duration-200">
          <div>
            <h3 class="text-sm text-blue-700 font-semibold uppercase tracking-wide mb-1">
              {group.region}
            </h3>
            <h2 class="text-lg font-bold text-neutral-800 mb-2">
              {group.name}
            </h2>
            <p class="text-sm text-neutral-600 mb-3 leading-relaxed">
              {group.description}
            </p>
            {group.location && (
              <p class="text-sm mb-1">
                📍 <span class="font-medium text-[var(--color-palette-four)]">{group.location}</span>
              </p>
            )}
            <p class="text-sm mb-2">
              🗓️ <span class="italic text-[var(--color-palette-four)]">{group.type} — {group.recurrence}</span>
            </p>
          </div>
          {group.link && (
            <a
              href={group.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-blue-600 mt-3 underline hover:text-blue-800 transition"
            >
              Learn more →
            </a>
          )}
        </div>
      ))}
    </div>

    <hr class="my-10 border-t border-[var(--color-palette-gray)]" />
    
    <div class="mt-15 bg-[var(--color-palette-one)] text-[var(--color-palette-five)] p-7 rounded-lg">
      <strong>Looking for more support options near you?</strong>
      <p >Many of these listings are provided through the Cancer Society of New Zealand, which works across Aotearoa to connect people and whānau facing cancer with compassionate, community-based care and services.</p>
      <p class="mt-7">
        🔗 Explore more support groups at <a href="https://www.cancer.org.nz/">cancer.org.nz</a>
      </p>
    </div>
  </div>
</Layout>