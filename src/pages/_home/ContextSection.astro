---
import Button from '../../components/ui/Button.astro';
import Carousel from '../../components/ui/Carousel.astro';

const { 
  content,
  config,
} = Astro.props;

const {
  title,
  description,
  // carouselImages,
  mainButton,
  link,
  mediaSource,
  paragraph,
} = content

const {
  margin=config.context.margin,
  padding=config.context.padding,
  scale=config.context.scale,
  other=config.context.other
} = config
---
<section class={`${margin} ${padding} ${other} ${scale}`} style="background: none">
  <hr class="my-15 w-ful mx-auto border-b border-[var(--color-palette-gray)]" />

  <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
    
    <div class="w-full md:w-1/2 max-w-3xl">
      <video 
        src={mediaSource}
        controls 
        class="w-full rounded-2xl shadow-lg border border-[var(--color-palette-gray)]"
      >
        Your browser does not support the video tag.
      </video>
    </div>

    <div class="md:w-1/2 text-center md:text-start px-5 md:px-0">
      <h1 class="text-2xl md:text-5xl lg:text-6xl font-bold mb-6">
        {title}
      </h1>
      <p class="text-lg md:text-xl mb-5 text-[var(--color-palette-four)]">
        {description}
      </p>
      <p class="text-md mb-8 text-[var(--color-palette-four)]">
        {paragraph}
      </p>
      <div class="flex gap-4 justify-center md:justify-start">
        <Button variant="primary" size="lg" href="/empty">
          Real Voices: Read Stories
        </Button>
        <Button variant="secondary" size="lg" href="/empty">
          Share Yours Now
        </Button>
      </div>
    </div>

  </div>
</section>
