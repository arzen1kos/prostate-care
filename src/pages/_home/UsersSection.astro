---
import Icon from '../../components/ui/Icon.astro';
// userContent from '../content/home.ts';
// componentConfiguration from '../lib/themes-and-layout/section-config';
const {
  id,
  content,
  config
} = Astro.props

const {
  sectionTitle = content.title,
  description = content.description,
  patients = content.users,
  others = content.other,
} = content

const {
  margin=config.user.margin,
  padding=config.user.padding,
  scale=config.user.scale,
  other=config.user.other
} = config
---

<section 
id="user-section"
class=`${margin} ${padding} ${other} ${scale}` style="background-color: var(--color-palette-four);">
  <div class="text-center px-6 md:px-4 md:py-5 lg:px-60 lg:py-5">
      <h2 class="font-bold mb-4" style="color: var(--color-palette-one);">{sectionTitle}</h2>
      <p class="text-center" style="color: var(--color-palette-two);">
      {description}
      </p>
  </div>
  <div class="flex items-center justify-center w-full scale-70 md:scale-85 lg:scale-110">
    <!-- Number Buttons with Horizontal Line -->
  
      <!-- Fixed-size Button Containers -->
       <div class="flex relative" id={id}>
         {patients.map(({ label, icon }) => (
         <div class="relative group w-15 h-15 hover:scale-110 hover:mx-3 flex items-center justify-center">
          <button
            id={label}
            type="button"
            data-active="false"
            data-label={label}
            class="user-btn w-full h-full flex p-5 items-center justify-center rounded-2xl md: text-xl text-s transition-all duration-200 hover:scale-110 "
            style="background: var(--color-palette-two); color: var(--color-palette-five);"
          >
            {icon}
            </button>
            <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm  rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
              Stage {icon.charAt(0).toUpperCase() + icon.slice(1)}
            </div>
          </div>
          <div class="flex items-center justify-center">
            <div class="h-0.5 w-4 md:w-10"  style="background-color: var(--color-palette-two);"></div>
          </div>
          ))}
      </div>
  
    <!-- Icon Buttons with Tooltip -->
    <div class="flex relative py-5">
      {others.map(({ label, icon }) => (
        <div class="flex items-center justify-center">
          <div class="h-0.5 w-4 md:w-10" style="background-color: var(--color-palette-three);"></div>
        </div>
        <div class="relative group w-15 h-15 flex items-center justify-center hover:scale-110 hover:mx-3">
          <button
            id={`btn-${label}`}
            type="button"
            data-active="false"
            data-label={label}
            style="background-color: var(--color-palette-two);"
            class="user-btn w-full h-full flex items-center justify-center rounded-xl text-xl transition-all duration-200" 
          >
            <Icon name={icon} class=".user-btn hover:text-white" color="var(--color-palette-four)"/>
          </button>
          <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm  rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
            {icon.charAt(0).toUpperCase() + icon.slice(1)}
          </div>
        </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { resourceContent } from '../../content/home'
  const { contentByCategory } = resourceContent;

  document.addEventListener('DOMContentLoaded', () => {
    const userButtonTabs = document.querySelectorAll('.user-btn[data-label]');
    const cardSection = document.getElementById('card-section');

    /* SCROLLING  */
    userButtonTabs.forEach(button => {
      button.addEventListener('click', () => {
       // Responsive offset scroll
      if (cardSection) {
        cardSection.classList.remove("hidden");
        let yOffset;
        if (window.innerWidth < 640) {
          // Small screens (e.g., mobile)
          yOffset = -140;
        } else if (window.innerWidth < 1024) {
          // Medium screens (e.g., tablets)
          yOffset = -260;
        } else {
          // Large screens (e.g., desktops)
          yOffset = -490;
        }

        const y = cardSection.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }

      // Remove active from all buttons
      userButtonTabs.forEach(btn => btn.removeAttribute('data-active'));
      // Add active to clicked button
      button.setAttribute('data-active', 'true');
      button.setAttribute('color', 'var(--color-palette-five)');
      

    /* CARD DYNAMIC  */
      // stage-0
      const labelText = button.getAttribute('data-label');
      localStorage.setItem('current', labelText)
      const currentSet = contentByCategory[labelText];
      // Stage X - Lorem Ipsum
      const cardMainTitle = document.getElementById('card-title');
      cardMainTitle.textContent = `${currentSet.title}`;

      // (Stage 0 Heading 1) What You Need to Know Early
      const linkSet = [];
      const cardHeadingElement = document.querySelectorAll('.card-heading');
      cardHeadingElement.forEach((heading, i)=> {
        heading.textContent = `${currentSet.data[i].heading}`;
        const cleanSlug = heading.textContent
          .toLowerCase()
          .trim()
          // Replace spaces, em dash, plus, ampersand with dash
          .replace(/[\s—+&]+/g, '-') 
          // Remove punctuation like commas, apostrophes, quotes, etc.
          .replace(/[’'“”"?!,.():;]+/g, '') 
          // Remove any characters except letters, numbers, dash, underscore
          .replace(/[^\w-]/g, '');

        linkSet.push(`${cleanSlug}`);
      });
      console.log(...linkSet);

      // Details
      const cardItemElements = document.querySelectorAll('.card-item');
      cardItemElements.forEach((card, i) => {
        const cardStatus = currentSet.data[i].cardStatus || 'complete';

        const incompleteBgColor = 'bg-[var(--color-palette-ghost)]';
        const completeBgColor = 'bg-[var(--color-palette-five)]';
        // Clear any previous override class
        card.classList.remove(incompleteBgColor, completeBgColor); // etc.

        if (cardStatus === 'incomplete') {
          card.classList.add(incompleteBgColor);
        } else {
          card.classList.add(completeBgColor);
        }
      });
      
      // Details
      const cardContentElement = document.querySelectorAll('.card-content');
      cardContentElement.forEach((content, i)=> {
        const items =  
        currentSet.data[i].content;
        const html = items.map(item => `
          <li style="position: relative; padding-left: 0.75rem;" class="scale-85 md:scale-95 text-[var(--color-palette-two)]">
              ${item}
          </li>
        `).join('');

        content.innerHTML = html;
        
      });

      const cardLinkElement = document.querySelectorAll('.card-rsc-item');
      cardLinkElement.forEach((link, i)=> {
        
        const current = localStorage.getItem('current');
        link.setAttribute('href', `${current}/${linkSet[i]}`);
      });
      });
    });
  });
</script>