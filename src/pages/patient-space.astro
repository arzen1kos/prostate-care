---
import Layout from '@layouts/Layout.astro';
import stages from '@contents/pages/patient-path.json';
import HubLanding from '@layouts/HubLanding.astro';
import { getEntry } from 'astro:content';

const page = await getEntry("hubPages", "patients");
if (!page) throw new Error("Missing hub page content: patients");
const content = page.data;

---

<Layout
    title="Patient Support Hub"
    description="Find information for navigating prostate cancer diagnosis, treatment, and well-being."
>
  <HubLanding content={content}>
    <div class="hub__content">
      <h2>I am looking for information on...</h2>
      <div class="patient-path__stages">
      {stages.map((stage, index) => (
          <details open={index === 0}>
          <summary>{stage.label}<span aria-hidden="true">⌄</span></summary>
          <ul class="patient-path__topics">
              {stage.topics.map((topic) => (
              <li>
                  <a href={topic.href}>
                  <img src="/public/assets/placeholders/placeholder-cards.png" alt="" loading="lazy" />
                  <span>{topic.title}</span>
                  </a>
              </li>
              ))}
          </ul>
          </details>
      ))}
      </div>
    </div>
  </HubLanding>

    <!-- <section class="patient-path hub">
    <div class="patient-path__hero hub__hero">
        <div>
        <nav aria-label="Breadcrumb">
            <a href="/welcome">Home</a><span aria-hidden="true">›</span><span>Finding your way</span>
