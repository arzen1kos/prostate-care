---
import '@styles/globals.css';

const title = 'Prometheus | Prostate Cancer Support Aotearoa';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff3e4" />
    <meta name="description" content="Prostate cancer information and support for patients, whānau, researchers, and clinicians." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="splash">
      <div class="splash__brand">
        <img src="/assets/logo/prometheus-app-logo.png" alt="Brand Logo" width="80" height="80" />
        <p class="splash__name">Prometheus</p>
        <p class="splash__subtitle">Prostate Cancer Support Website</p>
      </div>
      <p class="splash__footer">Te tautoko mō te matepukupuku repe tāne</p>
    </main>
    <script>
      window.setTimeout(() => window.location.replace('/welcome'), 3000);
    </script>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    min-height: 100%;
    margin: 0;
    background: var(--color-cream);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .splash {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    background: var(--color-cream);
    color: var(--color-navy);
    text-align: center;
  }

  .splash__brand img {
    display: block;
    width: 4rem;
    height: 4rem;
    margin-inline: auto;
    object-fit: contain;
  }

  .splash__name {
    margin: 0.8rem 0 0;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .splash__subtitle {
    margin: 0.4rem 0 0;
    color: var(--color-indigo);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .splash__footer {
    position: absolute;
    bottom: 1.5rem;
    color: var(--color-ink-muted);
    font-size: 0.85rem;
  }
</style>
