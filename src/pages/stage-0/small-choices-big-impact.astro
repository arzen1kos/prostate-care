---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-stage-0.ts';
import Icon from '../../components/ui/Icon.astro';
import Card from '../../components/ui/Card.astro';

const {
    heading = content['stage-0'].heading2.title,
    title = `Stage ${content['stage-0'].heading2.stageNum} - ${heading} | BluePrintNZ`,
    description = content['stage-0'].heading2.description,
    main = content['stage-0'].heading2.main,
    // link = content["stage-0"].heading2.description,
    breadcrumb = content['stage-0'].heading2.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---

<Layout title=`${title}`>
    <div class="container mx-auto px-4 pt-10 pb-25">
        <!-- 🧩 Header Component -->
        <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />
        <div class="max-w-4xl mx-auto">
            <span class="subheadings flex gap-3">
                {main.subheading}
                <!-- <a href=`${main.x.link}`>
                    <Icon class="card-icon scale-70" name="external-link" color="var(--color-palette-five)" />
                </a> -->
            </span>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 w-full py-10 place-items-center">
                {main.items.map(({head,content,link,image},index) => (
                <Card
                    id={`lifestyle-${head}`}
                    heading={head}
                    content={content}
                    // icon=[{name:"ac"}]
                    // textClass=""
                    // color=""
                    // config=""
                    index={index}
                    link={link}
                    image={image}
                    variant='simple'
                    />
                ))}
            </div>
        </div>
    </div>
</Layout>
