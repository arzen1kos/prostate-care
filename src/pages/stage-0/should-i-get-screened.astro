---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-stage-0.ts';
import Icon from '../../components/ui/Icon.astro';

import Callout from '../../components/ui/Callout.astro';

const {
    heading = content['stage-0'].heading3.title,
    title = `Stage ${content['stage-0'].heading3.stageNum} - ${heading} | BluePrintNZ`,
    description = content['stage-0'].heading3.description,
    main = content['stage-0'].heading3.main,
    // link = content["stage-0"].heading3.description,
    breadcrumb = content['stage-0'].heading3.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---

<Layout title=`${title}`>
    <div class="container mx-auto px-4 pt-10 pb-25">
        <!-- 🧩 Header Component -->
        <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />

        <Callout
            head="Important"
            content="Any detectable PSA in a man who has had his prostate removed for cancer is abnormal and must be followed up immediately."
        />
        <!--  -->
        <span class="subheadings mt-5 flex gap-3">
            <strong>{main.PSATest.subheading}</strong>
            <!-- <a href=`${main.PSATest.link}`> -->
                <!-- <span class="group hover:text-[var(--color-palette-two)] text-[var(--color-palette-five)] transition-colors duration-200">
            <Icon class="page-link-icon" name="external-link" />
          </span> -->
                <!-- <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)" /> -->
            <!-- </a> -->
        </span>
        <div class="pt-2">
            <p>{main.PSATest.body[0]}</p>
            <p>{main.PSATest.body[1]}</p>
        </div>
        <div class="ml-10 my-2">
            <p>{main.PSATest.summary[0]}</p>
            <p>{main.PSATest.summary[1]}</p>
            <p>{main.PSATest.summary[2]}</p>
            <p>{main.PSATest.summary[3]}</p>
        </div>
        <!--  -->
        <span class="subheadings mt-10 flex gap-3">
            {main.PSARecom.subheading}
            <a href=`${main.PSARecom.link}`>
                <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)" />
            </a>
        </span>
        <p class="pt-2">{main.PSARecom.body[0]}</p>
        <p class="pt-2">{main.PSARecom.body[1]}</p>
        <!--  -->
        <span class="subheadings mt-5 flex gap-3">
            {main.PSAResult.subheading}
            <a href=`${main.PSAResult.link}`>
                <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)" />
            </a>
        </span>
        <p class="pt-2">{main.PSAResult.body[0]}</p>
        <!--  -->
        <span class="subheadings mt-5 flex gap-3">
            {main.PSALimitations.subheading}
            <a href=`${main.PSALimitations.link}`>
                <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)" />
            </a>
        </span>
        {
            main.PSALimitations.body.map((item, index) => {
                if (typeof item === 'string') {
                    return <p class="pt-2">{item}</p>;
                } else if (Array.isArray(item.items)) {
                    return (
                        <ul class="list-disc list-inside pt-2">
                            {item.items.map((subItem, subIndex) => (
                                <li>{subItem}</li>
                            ))}
                        </ul>
                    );
                }
            })
        }
        <!--  -->
        <span class="subheadings mt-5 flex gap-3">
            {main.PSAMonitoring.subheading}
            <a href=`${main.PSAMonitoring.link}`>
                <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)" />
            </a>
        </span>
        {
            main.PSAMonitoring.body.map((item, index) => {
                if (typeof item === 'string') {
                    return <p class="pt-2">{item}</p>;
                } else if (Array.isArray(item.items)) {
                    return (
                        <ul class="list-disc list-inside pt-2">
                            {item.items.map((subItem, subIndex) => (
                                <li>{subItem}</li>
                            ))}
                        </ul>
                    );
                }
            })
        }
        <hr class="my-4 border-t border-[var(--color-palette-two)]0" />
        <h5>References</h5>
        <p>
            --+ <a href={main.PSATest.link} class="pt-2">{main.PSATest.link}</a>
        </p>
        <p>
            --+ <a
                href="https://tewaka-my.sharepoint.com/:b:/r/personal/ads0417_arastudent_ac_nz/Documents/Documents/20250220%20-%20SoftwareDev/Assignment%203/Files/Prostate%20Cancer/PDF%20Papers%20and%20Information%20Files/node-key/PSA%20testing%20and%20screening%20Otago%20Urology.pdf?csf=1&web=1&e=CgdAsR"
                class="pt-2">PSA testing and screening Otago Urology</a
            >
        </p>
    </div>
</Layout>
