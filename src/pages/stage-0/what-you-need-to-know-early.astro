---
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';
import { content } from '../../content/users/c-stage-0.ts';
import Icon from '../../components/ui/Icon.astro';

const {
    heading = content['stage-0'].heading1.title,
    title = `Stage ${content['stage-0'].heading1.stageNum} - ${heading} | BluePrintNZ`,
    description = content['stage-0'].heading1.description,
    main = content['stage-0'].heading1.main,
    breadcrumb = content['stage-0'].heading1.breadcrumbs
} = Astro.props;

const breadcrumbItems = [{ label: heading, link: breadcrumb.link, current: breadcrumb.current }];
---
<Layout title={`${title}`}>
  <div class="container mx-auto px-4 pt-10 pb-25 space-y-16">
    <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />

    <!-- Overview Section -->
    <section class="pt-10 space-y-6 px-5 md:px-4">
      <div>
        <h2 class="text-3xl font-semibold text-[var(--color-palette-five)]">
          {main.overview.subheading}
        </h2>
        <a
          href={main.overview.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-[var(--color-palette-five)] hover:underline"
        >
          Learn more
          <Icon name="external-link" class="scale-75" color="var(--color-palette-five)" />
        </a>
      </div>
      <div class="flex flex-col md:flex-row items-start justify-between gap-4">
        <img
          src={main.overview.image.src}
          alt={main.overview.image.alt}
          class="rounded-lg w-full md:w-1/2"
        />
        <div class="text-[var(--color-palette-five)] space-y-4 py-5">
          <p>{main.overview.body[0]}</p>
          <p>{main.overview.body[1]}</p>
          <ul class="list-disc list-inside space-y-1">
            {main.overview.body[2].items.map((item) => (
              <li class="text-[var(--color-palette-four)] pl-2">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- What It Is Section -->
    <section class="border-t pt-10 px-5 space-y-6" style={{ borderColor: 'var(--color-palette-five)' }}>
      <h2 class="text-2xl font-semibold text-[var(--color-palette-four)]">
        {main.whatItIs.subheading}
      </h2>
      <div class="text-[var(--color-palette-five)] space-y-4">
        {main.whatItIs.main.map((content, i) =>
          typeof content === 'string' ? (
            <p key={i}>{content}</p>
          ) : (
            <ul key={i} class="list-disc list-inside space-y-1">
              {content.items.map((item) => (
                <li class="text-[var(--color-palette-four)] pl-2">{item}</li>
              ))}
            </ul>
          )
        )}
      </div>
    </section>

    <!-- Screening Matters Section -->
    <section class="border-t pt-10 px-5 space-y-6" style={{ borderColor: 'var(--color-palette-five)' }}>
      <h2 class="text-2xl font-semibold text-[var(--color-palette-four)]">
        {main.screeningMatters.subheading}
      </h2>
      <div class="text-[var(--color-palette-five)] space-y-4">
        {main.screeningMatters.main.map((content, i) =>
          typeof content === 'string' ? (
            <p key={i}>{content}</p>
          ) : (
            <ul key={i} class="list-disc list-inside space-y-1">
              {content.items.map((item) => (
                <li class="text-[var(--color-palette-four)] pl-2">{item}</li>
              ))}
            </ul>
          )
        )}
      </div>
    </section>

    <!-- PSA Test Section -->
    <section class="border-t pt-10 pb-14 px-5 space-y-6" style={{ borderColor: 'var(--color-palette-five)' }}>
      <h2 class="text-2xl font-semibold text-[var(--color-palette-four)]">
        {main.psaTest.subheading}
      </h2>
      <div class="text-[var(--color-palette-five)] space-y-4">
        {main.psaTest.main.map((content, i) =>
          typeof content === 'string' ? (
            <p key={i}>{content}</p>
          ) : (
            <ul key={i} class="list-disc list-inside space-y-1">
              {content.items.map((item) => (
                <li class="text-[var(--color-palette-four)] pl-2">{item}</li>
              ))}
            </ul>
          )
        )}
      </div>
    </section>
  </div>
</Layout>
