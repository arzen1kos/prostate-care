{
    "extends": "astro/tsconfigs/base",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": {
        "@/*": ["./src/*"],
        "@components/*": ["./src/components/*"],
        "@contents/*": ["./content/*"],
        "@layouts/*": ["./src/layouts/*"],
        "@lib/*": ["./src/lib/*"],
        "@pages/*": ["./src/pages/*"],
        "@styles/*": ["./src/styles/*"],
        "@tests/*": ["./tests/*"],
        "@types/*": ["./src/types/*"],
        "@utils/*": ["./src/utils/*"]
        }
    }
}